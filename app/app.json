{
  "expo": {
    "name": "Xóm Lầy",
    "slug": "noi-tu",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huyphuoc.noitu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8590C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.huyphuoc.noitu"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Xóm Lầy chọn ảnh làm avatar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6f9fb2b3-7eb6-4fc9-b47f-998754cc2555"
      }
    },
    "owner": "phuochocbai"
  }
}
